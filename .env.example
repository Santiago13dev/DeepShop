# Variables de Entorno - Deepshop

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
DATABASE_URL=postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres

# ==============================================
# STRIPE CONFIGURATION
# ==============================================
STRIPE_PUBLIC_KEY=pk_test_tu-clave-publica
STRIPE_SECRET_KEY=sk_test_tu-clave-secreta
STRIPE_WEBHOOK_SECRET=whsec_tu-webhook-secret

# ==============================================
# SENDGRID / EMAIL CONFIGURATION
# ==============================================
SENDGRID_API_KEY=SG.tu-api-key
EMAIL_FROM=noreply@deepshop.com
EMAIL_FROM_NAME=Deepshop

# Alternativa SMTP (si no usas SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-password

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# ==============================================
# JWT CONFIGURATION
# ==============================================
JWT_SECRET=tu-secret-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# ==============================================
# SECURITY
# ==============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:4200

# ==============================================
# LOGGING & MONITORING
# ==============================================
LOG_LEVEL=debug
SENTRY_DSN=https://tu-sentry-dsn@sentry.io/proyecto

# ==============================================
# STORAGE
# ==============================================
SUPABASE_STORAGE_BUCKET=invoices

# ==============================================
# PAYMENT SETTINGS
# ==============================================
CURRENCY=usd
TAX_RATE=0.19
SHIPPING_COST=500

# ==============================================
# BUSINESS INFORMATION (Para Facturas)
# ==============================================
COMPANY_NAME=Deepshop Inc.
COMPANY_ADDRESS=123 Commerce Street, Tech City
COMPANY_TAX_ID=123456789
COMPANY_PHONE=+1-234-567-8900
COMPANY_EMAIL=info@deepshop.com
COMPANY_WEBSITE=https://deepshop.com
